<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        独立模块（不聚合进父 pom）：模拟器扮演"十公里外的设备"，自持最小依赖（仅 web），
        不继承 reason-faster 全局依赖（无数据源/无 Redis/无 Quartz）——设备侧不需要平台的能力。
        本地运行：mvn -pl ? （独立） -> cd reason-barrier-sim && mvn spring-boot:run
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.reason</groupId>
    <artifactId>reason-barrier-sim</artifactId>
    <version>1.0.0</version>
    <name>reason-barrier-sim</name>
    <description>升降杆样例：设备模拟器（扮演十公里外的物理杆，接收指令、执行动作、上报状态）</description>

    <properties>
        <java.version>17</java.version>
        <!-- RocketMQ 5.x gRPC 客户端（阶段2 事件双写，A2；版本写定禁止 LATEST。
             注：client-java 版本线独立于服务端，最新 5.2.2 适配 broker 5.3.1——见 document/block-records/MQ-ENV-NOTES.md） -->
        <rocketmq.client.version>5.2.2</rocketmq.client.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- RocketMQ 5.x gRPC 客户端（阶段2：事件双写走 MQ，proxy gRPC 8081） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client-java</artifactId>
            <version>${rocketmq.client.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
