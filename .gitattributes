# 换行统一：文本文件以 LF 入库/检出（GitHub 开源标准，消除 Windows 下 CRLF 警告）
* text=auto

# 文本：LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Windows 脚本：CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
