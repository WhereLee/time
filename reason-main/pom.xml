<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>reason-faster</artifactId>
        <groupId>com.reason</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>reason-main</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <description>reason-main 主系统</description>

    <properties>
        <google.zxing.version>3.5.3</google.zxing.version>
        <!-- RocketMQ 5.x gRPC 客户端（阶段2 事件通道，A1；版本写定禁止 LATEST。
             注：client-java 版本线独立于服务端，最新 5.2.2 适配 broker 5.3.1——见 document/block-records/MQ-ENV-NOTES.md） -->
        <rocketmq.client.version>5.2.2</rocketmq.client.version>
    </properties>

    <dependencies>
        <!-- RocketMQ 5.x gRPC 客户端（阶段2：设备事件消费，走 proxy gRPC 8081） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client-java</artifactId>
            <version>${rocketmq.client.version}</version>
        </dependency>
        <!-- google 二维码生成 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${google.zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${google.zxing.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 覆盖率（批次6 工程台账）：先出数字落档，CI 阈值门槛后议 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <finalName>${project.artifactId}-${project.version}</finalName>

    </build>

</project>