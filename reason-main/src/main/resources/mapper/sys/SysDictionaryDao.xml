<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.reason.modules.sys.dao.SysDictionaryDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.reason.modules.sys.entity.SysDictionaryEntity" id="sysDictionaryMap">
        <result property="dicId" column="dic_id"/>
        <result property="dicSort" column="dic_sort"/>
        <result property="dicKey" column="dic_key"/>
        <result property="dicValue" column="dic_value"/>
        <result property="dicRemark" column="dic_remark"/>
        <result property="dicCreator" column="dic_creator"/>
        <result property="dicCreatetime" column="dic_createtime"/>
        <result property="dicUpdatetime" column="dic_updatetime"/>
        <result property="dicStatus" column="dic_status"/>
    </resultMap>

    <!-- 取最大的Key -->
    <select id="getLatestKey" resultType="java.lang.Integer">
        SELECT
            IFNULL(MAX(dic_key),0)
        FROM
            sys_dictionary
        WHERE
            dic_sort = #{dicSort}
    </select>

    <!-- 设置IP黑白名单 -->
    <update id="setIpList">
        UPDATE sys_dictionary
        SET dic_value =
        CASE
                WHEN dic_key = 'white_list' THEN #{iplistVO.whiteList}
                WHEN dic_key = 'black_list' THEN #{iplistVO.blackList}
        END
        WHERE
            dic_sort = 'iplist'
    </update>

</mapper>